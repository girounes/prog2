        "acc = {k: KNeighborsClassifier(n_neighbors=k).fit(sc.transform(Xk_tr), yk_tr).score(sc.transform(Xk_te), yk_te)\n",
        "       for k in range(1, 26, 2)}\n",
        "print('Registros:', len(dk), '| treino:', len(Xk_tr), '| teste:', len(Xk_te))\n",
        "print('Acurácia no teste por K:', {k: round(v, 2) for k, v in acc.items()})\n",
