        "print('ANTES:', df['data_ultima_compra'].head(8).tolist())\n",
        "\n",
        "def padronizar_data(valor):\n",
        "    # Converte datas escritas em formatos diferentes (AAAA-MM-DD, DD/MM/AAAA e DD-MM-AAAA)\n",
        "    if pd.isna(valor):                                # mantém o ausente como ausente\n",
        "        return pd.NaT\n",
        "    valor = str(valor).strip()                        # remove espaços\n",
        "    if valor[:4].isdigit():                           # começa pelo ano -> formato AAAA-MM-DD\n",
