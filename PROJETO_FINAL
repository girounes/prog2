        "cols_knn = ['dias_desde_ultima_compra', 'qtd_ultima_compra', 'estoque_minimo', 'custo_unitario', 'margem_percentual']\n",
        "dk = base.dropna(subset=cols_knn + ['estoque_fisico']).copy()\n",
        "yk = (dk['situacao_estoque'] == 'Abaixo do mínimo').astype(int)\n",
        "Xk_tr, Xk_te, yk_tr, yk_te = train_test_split(dk[cols_knn], yk, test_size=0.25, random_state=42, stratify=yk)\n",
